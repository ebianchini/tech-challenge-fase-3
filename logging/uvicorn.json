{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe_server": {
      "()": "triage.infrastructure.logging.SafeServerFormatter"
    }
  },
  "handlers": {
    "safe_server": {
      "class": "logging.StreamHandler",
      "formatter": "safe_server",
      "stream": "ext://sys.stderr"
    },
    "discard": {
      "class": "logging.NullHandler"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["safe_server"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["safe_server"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["discard"],
      "level": "INFO",
      "propagate": false
    }
  }
}
