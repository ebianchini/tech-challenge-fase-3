    {
      "id": 4,
      "type": "stat",
      "title": "Modelo pronto · agora",
      "description": "Pronto somente se todos os alvos selecionados têm scrape UP e alguma versão carregada. Usa o máximo por instância para ignorar unknown=0 inicial; scrape falho ou gauge ausente resulta em indisponível. Sem alvo conhecido, fica sem coleta.",
      "datasource": {
        "type": "prometheus",
        "uid": "triage-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "pluginVersion": "13.2.4",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Pronto",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "Sem coleta",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "triage-prometheus"
          },
          "editorMode": "code",
          "expr": "min((max by (job, instance) (triage_model_ready{job=\"triage-api\",instance=~\"${instance:regex}\"}) or on (job, instance) (up{job=\"triage-api\",instance=~\"${instance:regex}\"} * 0)) * on (job, instance) up{job=\"triage-api\",instance=~\"${instance:regex}\"})",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
