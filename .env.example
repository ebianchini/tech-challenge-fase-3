# Local demonstration only. Do not reuse these credentials in production.
# Copy to .env only when overriding defaults; docker compose up works without it.
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=triage-local-demo

# Optional services: docker compose --profile airflow up -d --build --wait
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=airflow-local-demo
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Use URL-safe characters for this password because it is part of a database URI.
AIRFLOW_DB_PASSWORD=airflow-local-demo
AIRFLOW_WEBSERVER_SECRET_KEY=airflow-local-demo-web-secret
# Empty schedule means manual runs; DAGs are created paused.
TRIAGE_RETRAIN_SCHEDULE=
