{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {"Service": "ecs-tasks.amazonaws.com"},
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {"aws:SourceAccount": "__AWS_ACCOUNT_ID__"},
        "ArnLike": {
          "aws:SourceArn": "arn:aws:ecs:__AWS_REGION__:__AWS_ACCOUNT_ID__:*"
        }
      }
    }
  ]
}
