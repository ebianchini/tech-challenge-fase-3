{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubEnvironmentOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::__AWS_ACCOUNT_ID__:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:ebianchini/tech-challenge-fase-3:environment:__ENVIRONMENT__"
        }
      }
    }
  ]
}
